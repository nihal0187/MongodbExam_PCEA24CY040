
const hr = db.getSiblingDB("hr");

hr.employees.deleteMany({});

print("STEP 1: Insert Employees");
printjson(hr.employees.insertMany([
    {empId: 1, name: "Anita", dept: "HR", salary: 42000, city: "Chennai"},
    {empId: 2, name: "Bala", dept: "IT", salary: 65000, city: "Bengaluru"},
    {empId: 3, name: "Charan", dept: "IT", salary: 58000, city: "Chennai"},
    {empId: 4, name: "Deepa", dept: "Finance", salary: 50000, city: "Mumbai"},
    {empId: 5, name: "Elan", dept: "IT", salary: 72000, city: "Chennai"},
    {empId: 6, name: "Farah", dept: "HR", salary: 45000, city: "Delhi"},
    {empId: 7, name: "Gopal", dept: "Finance", salary: 61000, city: "Chennai"},
    {empId: 8, name: "Hema", dept: "Sales", salary: 38000, city: "Hyderabad"}
]));

print("STEP 2: Salary > 60000");
hr.employees.find({salary: {$gt: 60000}}).forEach(printjson);

print("STEP 3: Salary Between 45000 and 60000");
hr.employees.find({
    salary: {$gte: 45000, $lte: 60000}
}).forEach(printjson);

print("STEP 4: IT or Finance");
hr.employees.find({
    dept: {$in: ["IT", "Finance"]}
}).forEach(printjson);

print("STEP 5A: AND");
hr.employees.find({
    $and: [
        {city: "Chennai"},
        {salary: {$gt: 50000}}
    ]
}).forEach(printjson);

print("STEP 5B: OR");
hr.employees.find({
    $or: [
        {dept: "HR"},
        {salary: {$gt: 70000}}
    ]
}).forEach(printjson);

print("STEP 6: NIN");
hr.employees.find({
    city: {$nin: ["Chennai", "Bengaluru"]}
}).forEach(printjson);

print("STEP 7: REGEX");
hr.employees.find({
    name: {$regex: "^[ABC]"}
}).forEach(printjson);

print("STEP 8: SORT, SKIP AND LIMIT");
hr.employees.find(
    {},
    {_id: 0, name: 1, salary: 1}
).sort({salary: -1}).skip(2).limit(3).forEach(printjson);
